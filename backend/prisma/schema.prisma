generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(uuid())
  name      String
  email     String       @unique
  password  String
  role      String       @default("user")
  createdAt DateTime     @default(now())
  
  // Relations
  tasksAssigned CollabTask[] @relation("AssignedTasks")
  tasksCreated  CollabTask[] @relation("CreatedTasks")
}

model OrdemServico {
  id             String    @id @default(uuid())
  numero_os      String    @unique
  contrato       String?   
  processo       String?   
  sei            String?   
  tipo_servico   String?   
  equipamento    String?   
  modelo         String?   
  numero_serie   String?   
  unidade        String?   
  data_assinatura DateTime?
  status         String?   @default("Aberta")
  cronograma     String?   

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tarefas        Tarefa[]
}

model Tarefa {
  id             String        @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico  @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  
  data_tarefa    DateTime?     
  descricao      String        
  observacoes    String?       
  concluida      Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tratativas     Tratativa[]
}

model Tratativa {
  id                  String    @id @default(uuid())
  tarefaId            String
  tarefa              Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  
  data_tratativa      DateTime? 
  descricao           String    
  observacoes         String?   
  tratativa_retorno   String?   
  observacoes_retorno String?   
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Contract {
  id           String   @id // e.g., CT-012/2026
  vigencia     String
  processoMae  String
  tipo         String
  recurso      String
  valorGlobal  String
  valorMensal  String
  objeto       String
  quantidade   String
  execucao     String
  pendencia    String
  prazo        String
  status       String   // com_contrato, sem_contrato, garantia
  localizacao  String
  ultimaCons   String
  responsavel  String
}

model Licitacao {
  id           String   @id // e.g., Lic-045/2026
  processo     String
  autorizacao  String
  memoAbertura String
  modalidade   String
  fonteCusteio String
  valorPrevisto String
  objeto       String
  quantidade   String
  status       String   // em_andamento, homologada, deserta, suspensa
  localizacao  String
  data         String
  consultor    String
}

model CollabTask {
  id          String   @id
  text        String
  priority    String   @default("media") // alta, media, baixa
  completed   Boolean  @default(false)
  date        String
  
  authorId    String
  author      User     @relation("CreatedTasks", fields: [authorId], references: [id])
  
  assigneeId  String
  assignee    User     @relation("AssignedTasks", fields: [assigneeId], references: [id])
}
